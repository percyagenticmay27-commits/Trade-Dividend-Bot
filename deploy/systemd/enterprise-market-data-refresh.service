[Unit]
Description=Enterprise AI CIO Market Data Refresh (paper-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradebot
Group=tradebot
WorkingDirectory=/home/tradebot/Trade-Dividend-Bot
RuntimeDirectory=enterprise-market-data-handoff
RuntimeDirectoryMode=0750
StateDirectory=enterprise-market-data-cache
StateDirectoryMode=0750
EnvironmentFile=-/etc/tradebot/enterprise-market-data.env

# Pass 1 is unprivileged and uses YFinance -> configured Twelve Data -> fresh cache.
# It always exits zero so the conditional fallback evaluator can inspect evidence.
ExecStart=/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/refresh_enterprise_market_data_normalized.py --strategy-id SWING-001 --required-symbol SOXL --required-symbol TQQQ --cache-dir /var/lib/enterprise-market-data-cache --disable-robinhood --always-zero

# Only this tightly scoped command runs as root. It invokes Codex/Robinhood solely
# for quote or history operations still unresolved after the public/cache pass.
# Root's authenticated Codex profile is never copied or exposed to tradebot.
ExecStart=+/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/refresh_robinhood_fallback_handoffs.py --status-file /home/tradebot/Trade-Dividend-Bot/results/enterprise_market_data_status.json --output-dir /run/enterprise-market-data-handoff --period 1mo --interval 1d

# Pass 2 repeats the cost-aware chain and may consume a newly created Robinhood
# handoff only after YFinance, Twelve Data, and fresh cache remain unavailable.
ExecStart=/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/refresh_enterprise_market_data_normalized.py --strategy-id SWING-001 --required-symbol SOXL --required-symbol TQQQ --cache-dir /var/lib/enterprise-market-data-cache

TimeoutStartSec=300
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/enterprise-market-data-handoff /home/tradebot/Trade-Dividend-Bot/results

[Install]
WantedBy=multi-user.target
