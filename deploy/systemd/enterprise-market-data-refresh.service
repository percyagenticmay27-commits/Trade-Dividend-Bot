[Unit]
Description=Enterprise AI CIO Market Data Refresh (paper-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradebot
Group=tradebot
WorkingDirectory=/home/tradebot/Trade-Dividend-Bot
RuntimeDirectory=enterprise-market-data-handoff
RuntimeDirectoryMode=0750

# The leading + makes only these tightly scoped handoff commands run as root.
# Root's authenticated Codex profile is never copied or exposed to tradebot.
ExecStartPre=+/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/root_codex_market_data_handoff.py --operation get_quote --symbol SOXL
ExecStartPre=+/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/root_codex_market_data_handoff.py --operation get_history --symbol SOXL --period 1mo --interval 1d
ExecStartPre=+/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/root_codex_market_data_handoff.py --operation get_quote --symbol TQQQ
ExecStartPre=+/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/root_codex_market_data_handoff.py --operation get_history --symbol TQQQ --period 1mo --interval 1d

ExecStart=/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/refresh_enterprise_market_data.py --strategy-id SWING-001 --required-symbol SOXL --required-symbol TQQQ
TimeoutStartSec=240
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/.codex
ReadWritePaths=/run/enterprise-market-data-handoff /home/tradebot/Trade-Dividend-Bot/results /home/tradebot/Trade-Dividend-Bot/runtime

[Install]
WantedBy=multi-user.target
