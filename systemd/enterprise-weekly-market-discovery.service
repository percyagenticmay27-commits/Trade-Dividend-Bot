[Unit]
Description=Enterprise AI CIO Weekly Market Discovery (paper-only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tradebot
Group=tradebot
WorkingDirectory=/home/tradebot/Trade-Dividend-Bot
EnvironmentFile=-/etc/tradebot/enterprise-discovery.env
ExecStart=/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/scripts/collect_enterprise_discovery_sources.py
ExecStart=/home/tradebot/Trade-Dividend-Bot/.venv/bin/python /home/tradebot/Trade-Dividend-Bot/scripts/generate_enterprise_weekly_market_discovery.py
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
TimeoutStartSec=15min
