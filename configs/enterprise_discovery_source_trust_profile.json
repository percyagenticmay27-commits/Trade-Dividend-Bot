{
  "schema_version": "1.0",
  "policy": "FAIL_CLOSED_CONTINUOUS_SOURCE_DISCOVERY_NO_AUTO_ACTIVATION",
  "continuous_source_discovery": true,
  "auto_activate_new_sources": false,
  "tiers": {
    "TIER_1_PRIMARY_OFFICIAL": {
      "description": "Issuer, regulator, exchange, central-bank, or government primary-source evidence.",
      "may_support_primary_facts": true,
      "may_independently_create_favorable_catalyst": false
    },
    "TIER_2_PROFESSIONAL_NEWS": {
      "description": "Established professional newsroom or structured professional-news provider with identifiable publisher and provenance.",
      "may_support_primary_facts": false,
      "may_independently_create_favorable_catalyst": false
    },
    "TIER_3_REVIEWED_SPECIALIST": {
      "description": "Named analyst, educator, specialist, or creator explicitly reviewed for credibility and identity.",
      "may_support_primary_facts": false,
      "may_independently_create_favorable_catalyst": false
    },
    "TIER_4_DISCOVERY_ONLY": {
      "description": "Useful lead-generation source that cannot confirm a thesis, nomination, or favorable catalyst.",
      "may_support_primary_facts": false,
      "may_independently_create_favorable_catalyst": false
    }
  },
  "admission_requirements": {
    "https_required": true,
    "identifiable_publisher_required": true,
    "stable_provenance_required": true,
    "published_timestamp_required": true,
    "source_class_required": true,
    "symbol_identity_must_be_explicit_or_authoritatively_mapped": true,
    "reposts_without_original_provenance_rejected": true,
    "anonymous_social_sources_rejected": true,
    "popularity_alone_never_confirms": true,
    "item_code_or_headline_alone_never_confirms_favorable_event": true,
    "new_sources_require_review_before_activation": true,
    "periodic_revalidation_required": true
  },
